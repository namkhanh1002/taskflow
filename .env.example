# -----------------------------------------------------------------------------
# Neon PostgreSQL
# Lấy chuỗi kết nối trong Neon Dashboard -> Connection Details
#   - DATABASE_URL : pooled connection  (dùng cho application runtime)
#   - DIRECT_URL   : direct connection   (dùng cho Prisma migrate / CLI)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-westus2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx-westus2.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Authentication
# Tạo secret mới:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-random-32-bytes-hex-string"
AUTH_SESSION_TTL="604800"
